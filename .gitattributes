* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Integrity-pinned embedded OCIO assets: bytes are part of the product identity
*.cube -text
*.ocio -text

# Endurance profiles bind the exact raw workload bytes by SHA-256.
tests/validation/endurance-workloads/*.json -text

# Vendored package provenance binds original source/license bytes on every OS.
vendor/vst3-sdk/** -text
vendor/clap-sys/** -text
vendor/clack/** -text
vendor/crossbeam-queue/** -text
vendor/harfrust/** -text

# The exact official SDK notice includes a final blank line; preserve its hash.
LICENSES/VST3-SDK-MIT.txt -text whitespace=-blank-at-eof
vendor/vst3-sdk/LICENSE-SDK-MIT whitespace=-blank-at-eof
