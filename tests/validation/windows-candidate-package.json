{
  "schema_version": 1,
  "id": "windows-portable-candidate-v1",
  "runner": "windows-2022",
  "required_independent_passes": 3,
  "package": {
    "format": "zip",
    "required_root_files": [
      "mondrian.exe",
      "ffmpeg.exe",
      "ffprobe.exe",
      "LICENSE",
      "RELEASE_PROVENANCE.json",
      "MEDIA_RUNTIME_BUILD.txt",
      "FFMPEG_LICENSE.txt"
    ]
  },
  "runtime_verification": {
    "executable": "mondrian.exe",
    "arguments": [
      "--verify-runtime"
    ],
    "isolated_user_state_required": true,
    "sanitized_path_required": true,
    "proxy_denied_required": true
  }
}
