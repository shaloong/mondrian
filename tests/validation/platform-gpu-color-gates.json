        { "metric": "percentile_99_delta_e_itp", "comparison": "at_most", "limit": 0.5 },
        { "metric": "max_alpha_absolute_error", "comparison": "at_most", "limit": 0.001 }
      ]
    },
    {
      "id": "aces-pq-delta-e-itp",
      "target": "lib",
      "integration_test": null,
      "test": "color_stage::tests::gpu_aces_pq_intent_meets_delta_e_itp_budget_on_real_wgpu_device",
      "ignored": false,
      "measurements": [
        { "metric": "max_delta_e_itp", "comparison": "at_most", "limit": 0.55 },
        { "metric": "mean_delta_e_itp", "comparison": "at_most", "limit": 0.2 },
        { "metric": "percentile_99_delta_e_itp", "comparison": "at_most", "limit": 0.5 },
        { "metric": "max_alpha_absolute_error", "comparison": "at_most", "limit": 0.001 }
      ]
