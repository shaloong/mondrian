{
  "schema_version": 1,
  "id": "platform-gpu-color-gates-v1",
  "package": "mondrian-renderer",
  "all_features": true,
  "single_test_result_required": true,
  "diagnostic_skip_forbidden": true,
  "gates": [
    {
      "id": "output-smoke",
      "target": "lib",
      "integration_test": null,
      "test": "color_stage::tests::gpu_output_boundary_runtime_smoke_report_on_real_wgpu_device",
      "ignored": true,
      "measurements": [
        { "metric": "native_gpu_output_ready", "comparison": "at_least", "limit": 1.0 },
        { "metric": "readback_stages", "comparison": "at_most", "limit": 0.0 }
      ]
    },
    {
      "id": "standard-all-views-accuracy",
      "target": "lib",
      "integration_test": null,
      "test": "color_stage::tests::gpu_output_boundary_runtime_matches_cpu_for_all_standard_views_on_real_wgpu_device",
      "ignored": false,
      "measurements": [
        { "metric": "max_absolute_float_delta", "comparison": "at_most", "limit": 0.001 }
      ]
    },
    {
      "id": "standard-rec709-accuracy",
      "target": "lib",
      "integration_test": null,
