    {
      "id": "native-yuv-color-accuracy",
      "target": "lib",
      "integration_test": null,
      "test": "native_video::yuv_decode::tests::nv12_shader_decodes_limited_range_on_real_wgpu_device",
      "ignored": false,
      "measurements": [
        { "metric": "max_rgb_absolute_error", "comparison": "at_most", "limit": 0.0015 },
        { "metric": "max_alpha_absolute_error", "comparison": "at_most", "limit": 0.001 }
      ]
    },
    {
      "id": "standard-view-4k-performance",
      "target": "integration",
      "integration_test": "color_view_gpu_perf",
